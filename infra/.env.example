POSTGRES_USER=forecast
POSTGRES_PASSWORD=forecast
POSTGRES_DB=forecast
POSTGRES_PORT=5432
API_PORT=3000

N8N_HOST=localhost
N8N_PORT=5678
N8N_NGINX_PORT=8080
GENERIC_TIMEZONE=America/Bogota

# URL publica que n8n anuncia para sus webhooks y el editor. Por defecto usa
# nginx en local (http://localhost:8080/). Si corres `./forecast.sh public`
# (ngrok) con dominio fijo, pon aqui esa URL, ej:
# N8N_PUBLIC_URL=https://tu-dominio.ngrok-free.app/
N8N_PUBLIC_URL=

# Solo para `./forecast.sh public` (perfil "public": ngrok delante de n8n,
# para webhooks de Drive/OAuth desde internet). No hace falta para `up`.
# Conseguir el token en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Dominio fijo gratis (uno por cuenta) en https://dashboard.ngrok.com/domains
# Si lo dejas vacio, ngrok asigna una URL aleatoria en cada arranque.
NGROK_DOMAIN=
